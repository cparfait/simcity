# ============================================================
#  SimCity — Protection des fichiers sensibles
# ============================================================

# ─── Bloquer les fichiers et dossiers cachés (.git, .env…) ───
# Un déploiement qui monte le dépôt cloné dans le webroot exposerait sinon
# /.git/config puis tout l'historique : code source et secrets commités.
# mod_alias plutôt que mod_rewrite : il est chargé par défaut, donc la règle
# s'applique même sur une image où « a2enmod rewrite » n'a pas été fait.
<IfModule mod_alias.c>
    RedirectMatch 403 (^|/)\.(?!well-known)
</IfModule>

# ─── Bloquer l'accès direct à config.php ─────────────────────
<Files "config.php">
    Require all denied
</Files>

# ─── Bloquer l'accès direct à reset.php (sécurité critique) ──
# Restreignez à votre IP d'administration ou supprimez le fichier.
# Exemple : Require ip 192.168.1.0/24
<Files "reset.php">
    Require all denied
</Files>

# ─── Bloquer l'accès direct à install.php après installation ─
<Files "install.php">
    Require all denied
</Files>

# ─── Bloquer l'accès direct au dossier des sauvegardes ──────
# Les fichiers .sql contiennent toutes les données (signatures, mot de passe
# SMTP…). Ils ne doivent JAMAIS être servis directement : le téléchargement
# passe par index.php (?page=backup_download), après contrôle d'accès.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquer tout accès au dossier backups/
    RewriteRule ^backups/ - [F,L]

    # Bloquer tout script PHP dans uploads/
    RewriteRule ^uploads/.*\.php$ - [F,L]
    RewriteRule ^uploads/.*\.phtml$ - [F,L]
    RewriteRule ^uploads/.*\.phar$ - [F,L]

    # Bloquer l'accès direct aux PDF de factures opérateur : une facture
    # mensuelle contient la liste nominative complète du parc (noms, numéros,
    # consommations). Le téléchargement passe par index.php
    # (?page=invoice_pdf&id=…), après contrôle d'accès.
    RewriteRule ^uploads/invoices/ - [F,L]

    # Même règle pour les pièces jointes des fiches agents (justificatifs,
    # courriers, photos) : elles ne sont servies que par index.php
    # (?page=attachment&id=…), après contrôle de session. Seul le logo, affiché
    # dans les pages et les PDF, reste accessible directement.
    # L'exception porte sur le nom de fichier, pas sur un chemin absolu : une
    # installation en sous-répertoire (http://serveur/simcity/) donne un
    # REQUEST_URI « /simcity/uploads/pdf_logo_… », qu'une ancre « ^/uploads/ »
    # ne reconnaîtrait pas — le logo disparaîtrait alors de tous les e-mails.
    RewriteCond %{REQUEST_URI} !/uploads/pdf_logo_
    RewriteRule ^uploads/[^/]+$ - [F,L]

    # Défense en profondeur : aucun document bureautique n'est servi
    # statiquement par l'application (les PDF sont générés à la volée, le
    # modèle CSV et les factures archivées passent par index.php). Interdire
    # ces extensions à la racine du webroot couvre les fichiers de travail
    # qu'un déploiement pourrait y laisser — un dossier de factures réelles
    # déposé pour analyse, par exemple.
    RewriteRule \.(pdf|csv|xlsx|xls|sql)$ - [F,L]
</IfModule>

# ─── En-têtes de sécurité HTTP ────────────────────────────────
<IfModule mod_headers.c>
    # X-XSS-Protection est volontairement ABSENT : l'auditeur XSS des navigateurs
    # a été retiré de Chrome et n'a jamais existé sur Firefox. Ses dernières
    # implémentations introduisaient elles-mêmes des fuites de données par
    # filtrage sélectif — le réactiver dégraderait la sécurité au lieu de
    # l'améliorer. Ne pas le remettre.

    # Interdit le chargement dans une iframe (clickjacking)
    Header always set X-Frame-Options "DENY"

    # Équivalent moderne de X-Frame-Options, plus quelques verrous sans coût :
    # base-uri empêche un HTML injecté de détourner les URL relatives vers un
    # domaine tiers, object-src ferme les greffons Flash/Java.
    # Pas de script-src ni de style-src : les pages reposent massivement sur des
    # scripts et des styles en ligne ; une politique complète demanderait de tous
    # les externaliser ou de les signer par nonce, chantier à part entière.
    Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

    # Interdit au navigateur de deviner le type MIME
    Header always set X-Content-Type-Options "nosniff"

    # HTTPS only - décommenter si vous utilisez HTTPS
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Politique de référencement
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Cacher la version Apache ─────────────────────────────────
ServerSignature Off
