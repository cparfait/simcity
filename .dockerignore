# Exclus du contexte de build : ces éléments n'ont rien à faire dans le webroot
.git
.github
.gitignore
tests
vendor.lock.json
.gitattributes
# Fichiers de déploiement : docker-compose.yml porte les mots de passe de la
# base (et parfois LDAP/SMTP). Copiés dans le webroot, Apache les servirait.
docker-compose*.yml
Dockerfile
.dockerignore
*.md
*.sh
uploads
backups
db_data

# Données réelles déposées localement pour analyse (factures opérateur, relevés
# d'appels) : ignorées par git, elles seraient sinon copiées dans l'image par
# « COPY . » et servies par Apache. Doit rester aligné sur .gitignore.
Factures SFR
.claude
